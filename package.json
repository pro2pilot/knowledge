    "kb:self-test-agent-activity": "node tools/self-test-agent-activity.js --json",
    "kb:self-test-safe-queue": "node tools/self-test-safe-queue.js --json",
    "kb:self-test-agent-footer": "node tools/self-test-agent-footer.js --json",
    "kb:self-test-restore-trust": "node tools/self-test-restore-trust.js --json"
