    "kb:team:register": "node tools/workspace-register.js --json",
    "kb:team:status": "node tools/team-status.js --json",
    "kb:team:unregister": "node tools/workspace-unregister.js --json",
    "kb:worktree-status": "node tools/worktree-status.js --json",
    "kb:team:pr-summary": "node tools/team-pr-summary.js --json",
    "kb:self-test-team-mode": "node tools/self-test-team-mode.js",
    "kb:self-test-team-inspector-json": "node tools/self-test-team-inspector-json.js",
    "kb:self-test-pr-impact": "node tools/self-test-pr-impact.js",
