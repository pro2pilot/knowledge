{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pro2pilot.local/schemas/knowledge/pro-license-token.schema.json",
  "title": "Pro2Pilot Pro License Token",
  "type": "object",
  "required": ["subject", "plan", "entitlements", "issued_at", "expires_at", "activation_id", "signature"],
  "properties": {
    "subject": { "type": "string" },
    "email": { "type": "string" },
    "github_id": { "type": ["string", "null"] },
    "plan": { "type": "string", "enum": ["solo_pro", "team_pro", "enterprise"] },
    "entitlements": { "type": "array", "items": { "type": "string" } },
    "issued_at": { "type": "string" },
    "expires_at": { "type": "string" },
    "offline_grace_until": { "type": "string" },
    "activation_id": { "type": "string" },
    "machine_fingerprint_hash": { "type": "string" },
    "signature": { "type": "string" }
  },
  "additionalProperties": false
}
