{
  "schema_version": "knowledge-field-report.v2",
  "contract_version": "2.2.0",
  "product_version": "3.3.0",
  "title": "Field Report contract",
  "github_form": {
    "title": "[Field report] ",
    "introduction": "Starting with `.knowledge` 3.3.0, you can prepare this report semi-automatically with the `field-report` command. Answer in any language; the publication-ready draft is always English and requires tester-approved translation when needed. Only include things you actually observed. Review the final title and body before publishing, and never include secrets, private source code, personal data, internal workspace names, or internal addresses."
  },
  "automatic_evidence": {
    "facts_schema_version": "knowledge-field-report-facts.v2",
    "fact_fields": [
      "value",
      "kind",
      "source",
      "schema_path",
      "collected_at",
      "confidence",
      "warning"
    ],
    "trust_metrics": [
      "stale_artifacts_total",
      "modules_suspect",
      "modules_low_confidence",
      "modules_needing_recheck"
    ],
    "repair_metrics": [
      "repair_open",
      "repair_closed",
      "repair_reopened",
      "repair_unmanaged"
    ],
    "repository_profile": [
      "repository_tracked_files",
      "repository_tracked_bytes",
      "repository_source_files",
      "repository_source_bytes",
      "repository_profile_basis",
      "repository_profile_excluded_files"
    ],
    "public_outcomes": [
      "doctor_score",
      "doctor_status",
      "doctor_active_findings",
      "doctor_critical_findings",
      "wiki_structural_status",
      "wiki_broken_edges",
      "repair_task_readiness_status",
      "routing_task_readiness",
      "verification_receipts"
    ]
  },
  "translation": {
    "states": [
      "translation_not_required",
      "translation_required",
      "translation_ready",
      "translation_approved"
    ],
    "files": [
      "answers.original.json",
      "answers.translated.json",
      "translation-provenance.json",
      "translation-review.json"
    ]
  },
  "fields": [
    {
      "id": "knowledge-version",
      "type": "string",
      "required": false,
      "allowed_values": null,
      "human_label": ".knowledge version",
      "agent_prompt": null,
      "github_form": {
        "id": "knowledge-version",
        "type": "input",
        "label": ".knowledge version",
        "description": "Release version or commit SHA used during the test.",
        "placeholder": "Example: 3.3.0",
        "required": false
      },
      "renderer": {
        "section": "Project context",
        "label": ".knowledge version",
        "order": 10
      },
      "public_section": "Project context",
      "redaction_policy": "safe_aggregate",
      "omission_policy": "omit_when_unavailable"
    },
    {
      "id": "project-context",
      "type": "string",
      "required": true,
      "allowed_values": null,
      "human_label": "Project context",
      "agent_prompt": "Describe the repository or an anonymized equivalent, stack, agents, testing period, and previous context setup. Do not include internal workspace, department, or client names; repository size is collected automatically.",
      "github_form": {
        "id": "project-context",
        "type": "textarea",
        "label": "Project context",
        "description": "Describe the repository or an anonymized equivalent, stack, agents, testing period, and previous context setup. Repository size is collected automatically.",
        "placeholder": "Repository or anonymized description:\nStack:\nCoding agents:\nTesting period:\nPrevious context setup (generalized):",
        "required": true
      },
      "renderer": {
        "section": "Project context",
        "label": "Project context",
        "order": 20
      },
      "public_section": "Project context",
      "redaction_policy": "anonymize_private",
      "omission_policy": "omit_when_empty"
    },
    {
      "id": "report-relationship",
      "type": "enum",
      "required": true,
      "allowed_values": [
        "first_party_maintainer",
        "independent_user",
        "internal_qa",
        "controlled_comparison"
      ],
      "human_labels": {
        "first_party_maintainer": "First-party maintainer dogfooding",
        "independent_user": "Independent user report",
        "internal_qa": "Internal QA report",
        "controlled_comparison": "Controlled comparison"
      },
      "human_label": "Report relationship",
      "agent_prompt": "What is the tester’s relationship to .knowledge for this report?",
      "github_form": {
        "id": "report-relationship",
        "type": "dropdown",
        "label": "What type of report is this?",
        "description": "Choose the relationship that should be disclosed publicly.",
        "required": true
