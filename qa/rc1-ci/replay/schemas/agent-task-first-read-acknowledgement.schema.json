{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-agent-task-first-read-acknowledgement.v1",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_id",
    "task_id",
    "first_read_sha256",
    "finish_request_sha256",
    "acknowledged_at",
    "status",
    "receipt_id",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "knowledge-agent-task-first-read-acknowledgement.v1"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^ATW-[a-f0-9]{64}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "first_read_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "finish_request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "const": "acknowledged"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^ATFA-[a-f0-9]{64}$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
