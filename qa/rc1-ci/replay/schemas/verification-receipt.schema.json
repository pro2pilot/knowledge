{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pro2pilot.dev/schemas/knowledge-verification-receipt.v1.json",
  "title": ".knowledge verification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "content_sha256",
    "finding_id",
    "finding_occurrence_sha256",
    "module_id",
    "task_id",
    "session_id",
    "repair_mode",
    "source_files_checked",
    "tests_run",
    "claims_checked",
    "required_checks_completed",
    "resolution_predicate",
    "predicate_result",
    "checked_at",
    "checked_by",
    "task_scope_hash",
    "task_scope",
    "additional_work"
  ],
  "properties": {
    "schema_version": {
      "const": "knowledge-verification-receipt.v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^KVR-[a-f0-9]{64}$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^LC-[a-f0-9]{16}$"
    },
    "finding_occurrence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "module_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "repair_mode": {
      "enum": [
        "safe-only",
        "scoped",
        "aggressive",
        "dedicated"
      ]
    },
    "source_files_checked": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "tests_run": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "command_argv",
          "status",
          "exit_code",
          "tests_passed",
          "duration_ms",
          "execution_id",
          "execution_sha256",
          "execution_path",
          "stdout_sha256",
          "stderr_sha256"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "command_argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "const": "pass"
          },
          "exit_code": {
            "const": 0
          },
          "tests_passed": {
            "type": "integer",
            "minimum": 1
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0
          },
          "execution_id": {
            "type": "string",
            "pattern": "^KVE-[a-f0-9]{64}$"
          },
          "execution_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "execution_path": {
            "type": "string",
            "pattern": "^maintenance/verification_executions/[a-f0-9]{64}\\.json$"
          },
          "stdout_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stderr_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "claims_checked": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim",
          "result",
          "evidence"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "const": "confirmed"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "required_checks_completed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resolution_predicate": {
      "type": "string",
      "minLength": 1
    },
    "predicate_result": {
      "const": "pass"
    },
    "verification_status": {
      "type": "string",
      "minLength": 1
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "checked_by": {
      "type": "string",
      "minLength": 1
    },
    "task_scope_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modules",
        "artifacts"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "confirmation_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical_path",
        "security_finding",
        "exact_finding"
      ],
      "properties": {
        "critical_path": {
          "type": "boolean"
        },
        "security_finding": {
          "type": "boolean"
        },
        "exact_finding": {
          "type": "boolean"
        }
      }
    },
    "additional_work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_ms",
        "context_tokens",
        "context_percent",
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "wall_time_ms": {
          "type": "number",
          "minimum": 0
        },
        "context_tokens": {
          "type": "number",
          "minimum": 0
        },
        "context_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "input_tokens": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
