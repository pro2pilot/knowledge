# Optional root .gitattributes additions for .knowledge generated artifacts.
# No custom merge driver is required.
.knowledge/search/index.json linguist-generated=true
.knowledge/metrics/baseline.json linguist-generated=true
.knowledge/metrics/README.md linguist-generated=true
.knowledge/inspector/data.json linguist-generated=true
.knowledge/inspector/status.json linguist-generated=true
.knowledge/maintenance/routing_bundle.json linguist-generated=true
.knowledge/maintenance/trust_report.json linguist-generated=true
.knowledge/maintenance/quality_report.json linguist-generated=true
.knowledge/maintenance/pr_summary.md linguist-generated=true
.knowledge/maps/wiki_graph.json linguist-generated=true
.knowledge/maps/file_criticality.json linguist-generated=true
.knowledge/maintenance/graphs/*.mmd linguist-generated=true
