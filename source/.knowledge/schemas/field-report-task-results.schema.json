{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pro2pilot.dev/schemas/knowledge-field-report-task-results.v1.json",
  "title": ".knowledge Field Report evidence-bound task results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "task",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "knowledge-field-report-task-results.v1"
    },
    "report_id": {
      "type": "string",
      "pattern": "^fr_[0-9]{8}_[a-f0-9]{8}$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "outcome",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 8,
          "maxLength": 80
        },
        "outcome": {
          "enum": [
            "pass",
            "pass_with_warnings",
            "fail",
            "incomplete",
            "not_verified"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 8,
          "maxLength": 500
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "category",
          "status",
          "public_summary",
          "interpretation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
          },
          "label": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "category": {
            "enum": [
              "build",
              "typecheck",
              "tests",
              "lint",
              "security",
              "migration",
              "data_quality",
              "ui",
              "links_assets",
              "package",
              "deployment",
              "documentation",
              "other"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "warning",
              "fail",
              "not_run",
              "unavailable"
            ]
          },
          "public_summary": {
            "type": "string",
            "minLength": 3,
            "maxLength": 240
          },
          "interpretation": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320
          },
          "public": {
            "type": "boolean"
          },
          "metrics": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "passed": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              },
              "warnings": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            }
          },
          "evidence": {
            "oneOf": [
              {
                "$ref": "#/$defs/evidence"
              },
              {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome_relevant": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "snapshot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "properties": {
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "content_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "label",
        "root_kind",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "automated_report",
            "command_log",
            "receipt",
            "manual_review",
            "other"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "root_kind": {
          "enum": [
            "repository",
            "state"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "exit_code": {
          "type": "integer"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
